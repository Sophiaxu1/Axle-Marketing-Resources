# ===========================================================================
# Marketing Resources App — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in the values after provisioning.
# ===========================================================================

# ---------------------------------------------------------------------------
# Authifi (LS-Auth) — Backend
# ---------------------------------------------------------------------------
# OIDC issuer URL. Uses the tenant NAME (not numeric ID).
# Example: https://a-ci.ncats.io/_api/auth/tysonscohort
AUTHIFI_AUTHORITY=https://a-ci.ncats.io/_api/auth/<TENANT_NAME>

# Resource Server identifier registered in Authifi.
# Must match the "identifier" from the provisioning plan.
AUTHIFI_AUDIENCE=https://api.axle-marketing-resources.com

# ---------------------------------------------------------------------------
# Authifi (LS-Auth) — Frontend (VITE_ prefix exposes to browser)
# ---------------------------------------------------------------------------
# Same OIDC issuer URL as above.
VITE_AUTHIFI_AUTHORITY=https://a-ci.ncats.io/_api/auth/<TENANT_NAME>

# OAuth Client ID — assigned during Authifi provisioning.
VITE_AUTHIFI_CLIENT_ID=<CLIENT_ID_FROM_PROVISIONING>

# Resource Server identifier (audience) — same as AUTHIFI_AUDIENCE.
VITE_AUTHIFI_AUDIENCE=https://api.axle-marketing-resources.com

# (Optional) Override the authorize endpoint URL. When set, skips OIDC
# auto-discovery and uses this URL directly. Leave blank to auto-discover.
# VITE_AUTHIFI_AUTH_URL=https://a-ci.ncats.io/_api/auth/<TENANT_NAME>/authorize

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Public Supabase project URL (safe to expose to the browser).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (NEVER expose to browser — server only).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the Express server listens on.
# The Authifi callback URL is registered as http://localhost:3000/…
# so set this to 3000 during local development.
PORT=3000

# Node environment.
NODE_ENV=development
